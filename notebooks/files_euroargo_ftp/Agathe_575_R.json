{"EGODeployment": [{"DEPLOYMENT_ID": 575, "DEPLOYMENT_START_DATE": 20220115, "SUMMARY_REPORT": "This campaign involved the deployment of five seagliders in the Southern Ocean to investigate the Thwaites and Dotson Ice Shelves. The campaign is funded by The International Thwaites Glacier Collaboration, a collaboration between the US National Science Foundation (NSF) and UK Natural Environment Research Council (NERC). Four of the five gliders were successfully deployed in January 2022 from the US research ship Nathaniel B. Palmer. The glider Bella suffered a pressure sensor failure. Two gliders were lost during the deployment with the remaining three recovered in February 2022. These gliders were deployed alongside a glider from the ARTEMIS project.", "BASE_STATION": "available in the raw data", "EMAIL": "k.heywood@uea.ac.uk", "NAME": "Karen Heywood", "ACTIVE": 0, "CAMPAIGNNAME": "TARSAN", "PROJNAME": "TARSAN", "PLATFORMMODEL": [{"MODEL_VERSION_ID": 126, "MODEL_ID": 360, "CATEGORY_TYPE": "platforms", "DDESC": "M1", "PLATFORM_MAKER": "Kongsberg Maritime", "UNIQUE_ID": "B7600002", "PLATFORM_TYPE": "seaglider", "MODEL_NAME": "M1", "WMO_INST_TYPE": 830}], "PLATFORMINSTANCE": [{"PLAT_INSTANCE_VERSION_ID": 1551, "PLAT_INSTANCE_ID": 1096, "DATA_TYPE": "EGO glider time-series data", "GLIDER_SERIAL_NO": "sg127", "PLATFORM_CODE": "Agathe", "GLIDER_OWNER": "UEA", "ICES_PLATFORM_CODE": "N/A", "WMO_PLATFORM_CODE": 6801558, "PLATFORM_FAMILY": "open ocean glider"}], "SENSORLIST": [{"SENSORMODEL": [{"MODEL_VERSION_ID": 232, "MODEL_ID": 446, "SENSOR_MODEL": "Unpumped CT sail CTD", "SENSOR_MAKER": "Sea-Bird Scientific", "MODEL_NAME": "Sea-Bird Scientific Unpumped CT sail CTD"}], "SENSORINSTANCE": [{"SENSOR_INSTANCE_VERSION_ID": 1553, "SENSOR_INSTANCE_ID": 1098, "SENSOR_SERIAL_NO": "0050", "SENSOR_NAME": "Seaglider CT sail 0050"}], "PARAMETERLIST": [{"OBJECTTYPE": "parameter", "SDN_PARAMETER_URN": "http://vocab.nerc.ac.uk/collection/P01/current/CNDCST01/", "PREFLABEL": "Electrical condu